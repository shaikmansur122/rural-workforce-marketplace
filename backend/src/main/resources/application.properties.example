# ============================================================
# Rural Workforce Marketplace — Backend Configuration
# Copy this file to application.properties and fill in values
# DO NOT commit application.properties (it contains secrets)
# ============================================================

# ── Database ─────────────────────────────────────────────────
spring.datasource.url=jdbc:mysql://localhost:3306/rural_workforce?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ── JPA / Hibernate ──────────────────────────────────────────
# none     = do nothing (use this in production — schema managed manually)
# update   = auto-update schema (use only in development)
# create   = drop and recreate on startup (DANGEROUS — loses all data)
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ── Schema Initialization ────────────────────────────────────
# Set to 'always' to run schema.sql on startup (first time setup)
# Set to 'never' after tables are created
spring.sql.init.mode=never

# ── JWT ──────────────────────────────────────────────────────
# Use a long random string (min 32 characters) — keep this SECRET
jwt.secret=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS
# Token expiry in milliseconds (86400000 = 24 hours)
jwt.expiration-ms=86400000

# ── Server ───────────────────────────────────────────────────
server.port=8080

# ── File Upload ──────────────────────────────────────────────
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB
upload.dir=uploads

# Static file serving for uploaded images
spring.web.resources.static-locations=classpath:/static/,file:uploads/

# ── Logging (optional) ───────────────────────────────────────
# logging.level.org.springframework.security=DEBUG
# logging.level.com.ruralworkforce=DEBUG
